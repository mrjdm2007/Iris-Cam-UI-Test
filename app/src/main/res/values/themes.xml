<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Iris Cam</string>

    <!-- App-wide Material 3 dark foundation. The camera view remains intentionally edge-to-edge. -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorPrimaryContainer">#4F378B</item>
        <item name="colorOnPrimaryContainer">#EADDFF</item>
        <item name="colorSecondary">#CCC2DC</item>
        <item name="colorOnSecondary">#381E72</item>
        <item name="colorSecondaryContainer">#4A4458</item>
        <item name="colorOnSecondaryContainer">#E8DEF8</item>
        <item name="colorTertiary">#EFB8C8</item>
        <item name="colorSurface">#141218</item>
        <item name="colorOnSurface">#E6E0E9</item>
        <item name="colorSurfaceVariant">#2B2930</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="colorOutline">#49454F</item>
        <item name="colorError">#F2B8B5</item>
        <item name="android:colorAccent">#D0BCFF</item>
        <item name="android:statusBarColor">#0F0D13</item>
        <item name="android:navigationBarColor">#0F0D13</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#0F0D13</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.IrisCam.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.IrisCam.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorSecondary">#CCC2DC</item>
    </style>
</resources>
